{
  "expo": {
    "name": "MoPay",
    "slug": "fstApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/splash-ios.png",
    "resizeMode": "contain",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/splash-ios.png",
      "resizeMode": "contain",
      "backgroundColor": "#00cc99"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fistlastn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00cc99"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fistlast"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "82cea3fd-a8ea-4f43-b28b-eb61f9525823"
      }
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/82cea3fd-a8ea-4f43-b28b-eb61f9525823"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
